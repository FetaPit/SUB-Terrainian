# SUB-Terrainian environment — copy to .env and fill in values
# Never commit .env

# Python pipeline
MANIFEST_PATH=sub_terrainian.db

# IPFS pinning (Pinata) — optional for local-only use
PINATA_JWT=

# Base / Basescan
BASE_RPC_URL=https://mainnet.base.org
BASESCAN_API_KEY=

# Wallet (deployer — never store private key here, use hardware wallet or cast)
DEPLOYER_ADDRESS=

# Deployed contract addresses (filled in post-deploy)
MUSIC_EDITION_ADDRESS=
PHYSICAL_CLAIM_ADDRESS=

# TheAudioDB — register at theaudiodb.com, shared test key is 123
THEAUDIODB_KEY=123
